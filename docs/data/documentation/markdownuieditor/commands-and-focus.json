{"sections":[],"abstract":[{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor\/MarkdownEditorCommand"},{"text":" describes a typed editing action. Native text views expose ","type":"text"},{"type":"codeVoice","code":"canPerform(_:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"perform(_:)"},{"text":".","type":"text"}],"metadata":{"roleHeading":"Article","title":"Commands and focus","modules":[{"name":"MarkdownUIEditor"}],"role":"article"},"hierarchy":{"paths":[["doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"syntax":"swift","type":"codeListing","code":["import MarkdownUIEditor","import UIKit","","let textView = MarkdownTextView(usingTextLayoutManager: true)","textView.document = MarkdownDocument(markdown: \"A sentence\")","","let command = MarkdownEditorCommand.toggleInline(.strong)","if textView.canPerform(command) {","    textView.perform(command)","}"]},{"type":"paragraph","inlineContent":[{"text":"Commands cover inline styling, block and list conversion, links, images, indentation, task state, thematic breaks, and table edits. A structural command is one native undo operation. Inline formatting and list conversion also support selections spanning multiple blocks. An inline command at a collapsed insertion point changes typing attributes, so subsequent text receives the style without inserting Markdown markers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Select text and open its contextual menu to access ","type":"text"},{"type":"strong","inlineContent":[{"text":"Style → Bold","type":"text"}]},{"text":", ","type":"text"},{"type":"strong","inlineContent":[{"text":"Italic","type":"text"}]},{"text":", or ","type":"text"},{"type":"strong","inlineContent":[{"text":"Strikethrough","type":"text"}]},{"text":". This works in ordinary document text and table cells, using a right-click on macOS or the text-editing menu on iOS. Table cells additionally offer the ","type":"text"},{"type":"strong","inlineContent":[{"text":"Table","type":"text"}]},{"text":" submenu for row, column, and alignment commands. The standard system editing actions remain available.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"SwiftUI hosts can add controls that operate on the currently focused editor through ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor\/MarkdownEditorContext"},{"text":".","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import MarkdownUIEditor","import SwiftUI","","struct BoldButton: View {","    @FocusedValue(\\.markdownEditorContext) private var editor","","    var body: some View {","        Button(\"Bold\") {","            editor?.perform(.toggleInline(.strong))","        }","        .disabled(editor?.canPerform(.toggleInline(.strong)) != true)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The context is absent when no ","type":"text"},{"type":"codeVoice","code":"MarkdownEditor"},{"text":" is focused. It never edits a background editor by accident.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MarkdownEditorContext"},{"text":" is observable. Custom toolbars that retain a context should observe it with ","type":"text"},{"type":"codeVoice","code":"@ObservedObject"},{"text":" and use ","type":"text"},{"type":"codeVoice","code":"isActive(_:)"},{"text":" to display selected formatting. At a collapsed caret, inline commands apply to subsequent typing, including inside a table cell.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/markdownuieditor\/commands-and-focus"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Editing","generated":true,"anchor":"Editing","identifiers":[