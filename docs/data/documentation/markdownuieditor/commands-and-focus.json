.","type":"text"}],"title":"MarkdownUIEditor","kind":"symbol","identifier":"doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor","url":"\/documentation\/markdownuieditor"},"doc://MarkdownUIEditor/documentation/MarkdownUIEditor/Platform-behavior":{"role":"article","type":"topic","abstract":[{"text":"On iOS and Mac Catalyst, ","type":"text"},{"type":"codeVoice","code":"MarkdownTextView"},{"text":" subclasses ","type":"text"},{"type":"codeVoice","code":"UITextView"},{"text":". It supports touch selection, Dynamic Type, the native undo manager, hardware keyboard commands, edit menus, drag and drop, and an input assistant with bold and italic actions.","type":"text"}],"title":"Platform behavior","kind":"article","identifier":"doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor\/Platform-behavior","url":"\/documentation\/markdownuieditor\/platform-behavior"},"doc://MarkdownUIEditor/documentation/MarkdownUIEditor/MarkdownEditorCommand":{"role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MarkdownEditorCommand","kind":"identifier"}],"abstract":[{"text":"A logical edit that can be applied to a ","type":"text"},{"type":"codeVoice","code":"MarkdownDocument"},{"text":" as one undo unit.","type":"text"}],"navigatorTitle":[{"text":"MarkdownEditorCommand","kind":"identifier"}],"title":"MarkdownEditorCommand","kind":"symbol","identifier":"doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor\/MarkdownEditorCommand","url":"\/documentation\/markdownuieditor\/markdowneditorcommand"},"doc://MarkdownUIEditor/documentation/MarkdownUIEditor/MarkdownEditor":{"role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MarkdownEditor","kind":"identifier"}],"abstract":[{"text":"A SwiftUI wrapper around the platform-native Markdown editor.","type":"text"}],"navigatorTitle":[{"text":"MarkdownEditor","kind":"identifier"}],"title":"MarkdownEditor","kind":"symbol","id