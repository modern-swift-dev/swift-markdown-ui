{"sections":[],"abstract":[{"text":"Use a document binding when the app needs structured Markdown. Use a string binding when it stores Markdown source.","type":"text"}],"metadata":{"roleHeading":"Article","title":"SwiftUI editor","modules":[{"name":"MarkdownUIEditor"}],"role":"article"},"hierarchy":{"paths":[["doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"syntax":"swift","type":"codeListing","code":["import MarkdownUIEditor","import SwiftUI","","struct DocumentEditor: View {","    @State private var document = MarkdownDocument(markdown: \"# Draft\")","","    var body: some View {","        MarkdownEditor(document: $document)","            .markdownEditorTheme(.gitHub)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The string initializer parses the binding value on input and writes normalized Markdown after an edit.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Assign a new value to the binding to replace the document, such as when opening","type":"text"},{"text":" ","type":"text"},{"text":"another note or restoring a saved version. Use a document binding when you also","type":"text"},{"text":" ","type":"text"},{"text":"need to retain empty paragraphs during editing; Markdown source normalizes them.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import MarkdownUIEditor","import SwiftUI","","struct SourceEditor: View {","    @State private var markdown = \"A [relative link](guide.md)\"","","    var body: some View {","        MarkdownEditor(markdown: $markdown, baseURL: URL(string: \"https:\/\/example.com\/docs\/\")!)","            .markdownEditorShowsFormattingToolbar(false)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"baseURL"},{"text":" resolves relative image URLs in the editor projection. It do