{"sections":[],"abstract":[{"text":"Tables are represented by ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor\/MarkdownTable"},{"text":" and displayed as native TextKit attachments. Cells display editable rich text with the same inline GFM formatting as the document. Formatting commands use the visible cell selection. Return inserts a visible newline and stores it as ","type":"text"},{"type":"codeVoice","code":"<br \/>"},{"text":". ","type":"text"},{"type":"codeVoice","code":"Tab"},{"text":" moves forward, ","type":"text"},{"type":"codeVoice","code":"Shift-Tab"},{"text":" moves backward, and reaching the final cell adds a row. Column alignment follows the table model, and the grid grows and wraps within the editor width as cells change. A table remains one structural document node.","type":"text"}],"metadata":{"roleHeading":"Article","title":"Tables, images, and HTML","modules":[{"name":"MarkdownUIEditor"}],"role":"article"},"hierarchy":{"paths":[["doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Cell changes flow through the table controller to the enclosing editor’s document and undo history. Hosts can still use the controller’s source API to read or replace a cell as Markdown.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Right-click a cell on macOS, or open a cell’s text-editing menu on iOS, and choose ","type":"text"},{"type":"strong","inlineContent":[{"text":"Table","type":"text"}]},{"text":" to add, delete, or move rows and columns and change column alignment. Commands target that cell and participate in the editor’s undo history. Unavailable operations, such as deleting the header row, are disabled. These contextual controls are available even when the formatting toolbar is hidden.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor\/MarkdownTableController"},{"text":" when a host needs direct table operations outside the text view.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import MarkdownUIEditor","","var table = MarkdownTable(","    alignments: [.left, .right],","    header: MarkdownTableRow(cells: [","        MarkdownTableCell(content: [.text(\"Item\")]),","        MarkdownTableCell(content: [.text(\"Count\")])","    ]),","    rows: []",")","","let controller = MarkdownTableController(table: table)","controller.appendRow()","table = controller.table"]},{"type":"paragraph","inlineContent":[{"text":"Images keep their Markdown URL, title, and alt text in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor\/MarkdownImageMetadata"},{"text":". An optional ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor\/MarkdownEditorImageProvider"},{"text":" resolves a URL to a platform image for display. The editor does not upload, store, or generate image assets.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Image loading is opt-in. In SwiftUI, keep a provider in your view or model and set","type":"text"},{"text":" ","type":"text"},{"text":"it with ","type":"text"},{"type":"codeVoice","code":"markdownEditorImageProvider(_:)"},{"text":". Relative image paths resolve against","type":"text"},{"text":" ","type":"text"},{"text":"the editor’s ","type":"text"},{"type":"codeVoice","code":"baseURL"},{"text":". Without a provider, the image attachment displays its","type":"text"},{"text":" ","type":"text"},{"text":"alternative text.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import MarkdownUIEditor","import SwiftUI","","struct IllustratedNotes: View {","    @State private var markdown = \"![Diagram](images\/diagram.png)\"","    @State private var imageProvider = MarkdownURLSessionImageProvider()","","    var body: some View {","        MarkdownEditor(","            markdown: $markdown,","            baseURL: URL(string: \"https:\/\/example.com\/notes\/\")","        )","        .markdownEditorImageProvider(imageProvider)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Implement ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor\/MarkdownEditorImageProvider"},{"text":" for local assets, caching, or custom","type":"text"},{"text":" ","type":"text"},{"text":"networking. For native TextKit integration, pass a provider to the attachment:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import MarkdownUIEditor","","let provider = MarkdownURLSessionImageProvider()","let metadata = MarkdownImageMetadata(source: \"https:\/\/example.com\/image.png\", altText: \"Example\")","let attachment = MarkdownImageAttachment(metadata: metadata, imageProvider: provider)"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MarkdownBlock.html"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"MarkdownInline.html"},{"text":" preserve raw HTML as source. HTML is never executed or previewed.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/markdownuieditor\/tables-images-and-html"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Supporting content","generated":true,"anchor":"Supporting-content","identifiers":["doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor\/MarkdownEditorTheme","doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor\/MarkdownEditorImageProvider"]}],"kind":"article","identifier":{"url":"doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor\/Tables-images-and-HTML","interfaceLanguage":"swift"},"references":{"doc://MarkdownUIEditor/documentation/MarkdownUIEditor/MarkdownTableController":{"role":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MarkdownTableController","kind":"identifier"}],"abstract":[{"text":"Mutable table state shared by an attachment and its native view provider.","type":"text"}],"navigatorTitle":[{"text":"MarkdownTableController","kind":"identifier"}],"title":"MarkdownTableController","kind":"symbol","identifier":"doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor\/MarkdownTableController","url":"\/documentation\/markdownuieditor\/markdowntablecontroller"},"doc://MarkdownUIEditor/documentation/MarkdownUIEditor":{"role":"collection","type":"topic","abstract":[{"text":"Create and edit GitHub Flavored Markdown with native text controls on iOS, Mac Catalyst, and macOS.","type":"text"}],"title":"MarkdownUIEditor","kind":"symbol","identifier":"doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor","url":"\/documentation\/markdownuieditor"},"doc://MarkdownUIEditor/documentation/MarkdownUIEditor/MarkdownTable":{"role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MarkdownTable","kind":"identifier"}],"abstract":[{"text":"A GitHub Flavored Markdown table.","type":"text"}],"navigatorTitle":[{"text":"MarkdownTable","kind":"identifier"}],"title":"MarkdownTable","kind":"symbol","identifier":"doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor\/MarkdownTable","url":"\/documentation\/markdownuieditor\/markdowntable"},"doc://MarkdownUIEditor/documentation/MarkdownUIEditor/MarkdownImageMetadata":{"role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MarkdownImageMetadata","kind":"identifier"}],"abstract":[{"text":"The Markdown fields that describe an image reference.","type":"text"}],"navigatorTitle":[{"text":"MarkdownImageMetadata","kind":"identifier"}],"title":"MarkdownImageMetadata","kind":"symbol","identifier":"doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor\/MarkdownImageMetadata","url":"\/documentation\/markdownuieditor\/markdownimagemetadata"},"doc://MarkdownUIEditor/documentation/MarkdownUIEditor/MarkdownEditorImageProvider":{"role":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MarkdownEditorImageProvider","kind":"identifier"}],"abstract":[],"navigatorTitle":[{"text":"MarkdownEditorImageProvider","kind":"identifier"}],"title":"MarkdownEditorImageProvider","kind":"symbol","identifier":"doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor\/MarkdownEditorImageProvider","url":"\/documentation\/markdownuieditor\/markdowneditorimageprovider"},"doc://MarkdownUIEditor/documentation/MarkdownUIEditor/MarkdownEditorTheme":{"role":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MarkdownEditorTheme","kind":"identifier"}],"abstract":[{"text":"Attributes used when projecting a ","type":"text"},{"type":"codeVoice","code":"MarkdownDocument"},{"text":" into native rich text.","type":"text"}],"navigatorTitle":[{"text":"MarkdownEditorTheme","kind":"identifier"}],"title":"MarkdownEditorTheme","kind":"symbol","identifier":"doc:\/\/MarkdownUIEditor\/documentation\/MarkdownUIEditor\/MarkdownEditorTheme","url":"\/documentation\/markdownuieditor\/markdowneditortheme"}}}