":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"A finite, positive width is required for every column. Invalid widths or a","type":"text"},{"text":" ","type":"text"},{"text":"count that does not match a table preserve its content-sized, eager layout.","type":"text"},{"text":" ","type":"text"},{"text":"With ","type":"text"},{"type":"codeVoice","code":".lazyContainers"},{"text":", matching widths allow table rows to be created as","type":"text"},{"text":" ","type":"text"},{"text":"they approach the visible region when borders use a standard solid stroke","type":"text"},{"text":" ","type":"text"},{"text":"with a positive, whole-point line width. Custom strokes, dashed borders,","type":"text"},{"text":" ","type":"text"},{"text":"and fractional border widths retain eager layout to preserve their exact","type":"text"},{"text":" ","type":"text"},{"text":"appearance. Offscreen row heights remain estimated.","type":"text"},{"text":" ","type":"text"},{"text":"Other rendering modes honor matching widths while measuring all rows.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/markdownui\/swiftuicore\/view\/markdowntablecolumnwidths(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/SwiftUICore\/View\/markdownTableColumnWidths(_:)","interfaceLanguage":"swift"},"references":{"doc://MarkdownUI/documentation/MarkdownUI/SwiftUICore/View":{"role":"symbol","type":"topic","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"identifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"abstract":[],"navigatorTitle":[{"text":"View","kind":"identifier"}],"title":"View","kind":"symbol","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/SwiftUICore\/View","url":"\/documentation\/markdownui\/swiftuicore\/view"},"doc://MarkdownUI/documentation/MarkdownUI/SwiftUICore/View/markdownTableColumnWidths(_:)":{"rol