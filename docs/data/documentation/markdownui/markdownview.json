{"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/MarkdownUI\/s8SendableP","doc:\/\/MarkdownUI\/s16SendableMetatypeP","doc:\/\/MarkdownUI\/7SwiftUI4ViewP"]}],"sections":[],"abstract":[{"text":"A view that displays read-only Markdown content.","type":"text"}],"metadata":{"roleHeading":"Structure","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MarkdownView","kind":"identifier"}],"symbolKind":"struct","modules":[{"name":"MarkdownUI"}],"navigatorTitle":[{"text":"MarkdownView","kind":"identifier"}],"title":"MarkdownView","externalID":"s:10MarkdownUI0A4ViewV"},"hierarchy":{"paths":[["doc:\/\/MarkdownUI\/documentation\/MarkdownUI"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownView\/init(_:baseURL:imageBaseURL:)-65h4g","doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownView\/init(_:baseURL:imageBaseURL:)-6acz4","doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownView\/init(baseURL:imageBaseURL:content:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownView\/body"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownView\/View-Implementations","doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownView\/View-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MarkdownView","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"Markdown"},{"text":" view displays rich structured text using the Markdown syntax. It is compatible with the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.github.com\/gfm\/"},{"text":" and can display","type":"text"},{"text":" ","type":"text"},{"text":"images, headings, lists (including task lists), blockquotes, code blocks, tables, and thematic breaks,","type":"text"},{"text":" ","type":"text"},{"text":"besides styled text and links.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The simplest way of creating a ","type":"text"},{"type":"codeVoice","code":"Markdown"},{"text":" view is to pass a Markdown string to the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownView\/init(_:baseURL:imageBaseURL:)-65h4g"},{"text":" initializer.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let markdownString = \"\"\"","  ## Try MarkdownUI","","  **MarkdownUI** is a native Markdown renderer for SwiftUI","  compatible with the","  [GitHub Flavored Markdown Spec](https:\/\/github.github.com\/gfm\/).","  \"\"\"","","var body: some View {","  MarkdownView(markdownString)","}"]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"MarkdownString"}]},{"type":"paragraph","inlineContent":[{"text":"A more convenient way to create a ","type":"text"},{"type":"codeVoice","code":"Markdown"},{"text":" view is by using the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownView\/init(baseURL:imageBaseURL:content:)"},{"text":" ","type":"text"},{"text":"initializer, which takes a Markdown content builder in which you can compose the view content, either by providing Markdown strings","type":"text"},{"text":" ","type":"text"},{"text":"or by using an expressive domain-specific language.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var body: some View {","  MarkdownView {","    \"\"\"","    ## Using a Markdown Content Builder","    Use Markdown strings or an expressive domain-specific language","    to build the content.","    \"\"\"","    Heading(.level2) {","      \"Try MarkdownUI\"","    }","    Paragraph {","      Strong(\"MarkdownUI\")","      \" is a native Markdown renderer for SwiftUI\"","      \" compatible with the \"","      InlineLink(","        \"GitHub Flavored Markdown Spec\",","        destination: URL(string: \"https:\/\/github.github.com\/gfm\/\")!","      )","      \".\"","    }","  }","}"]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"MarkdownContentBuilder"}]},{"type":"paragraph","inlineContent":[{"text":"You can also create a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownContent"},{"text":" value in your model layer and later create a ","type":"text"},{"type":"codeVoice","code":"Markdown"},{"text":" view by passing","type":"text"},{"text":" ","type":"text"},{"text":"the content value to the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownView\/init(_:baseURL:imageBaseURL:)-6acz4"},{"text":" initializer. The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownContent"},{"text":" ","type":"text"},{"text":"value pre-parses the Markdown string preventing the view from doing this step.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Somewhere in the model layer","let content = MarkdownContent(\"You can try **CommonMark** [here](https:\/\/spec.commonmark.org\/dingus\/).\")","","\/\/ Later in the view layer","var body: some View {","  MarkdownView(self.model.content)","}"]},{"text":"Styling Markdown","type":"heading","anchor":"Styling-Markdown","level":3},{"type":"paragraph","inlineContent":[{"text":"Markdown views use a basic default theme to display the contents. For more information, read about the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/Theme\/basic"},{"text":" theme.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["MarkdownView {","  \"\"\"","  You can quote text with a `>`.","","  > Outside of a dog, a book is man's best friend. Inside of a","  > dog it's too dark to read.","","  – Groucho Marx","  \"\"\"","}"]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"BlockquoteContent"}]},{"type":"paragraph","inlineContent":[{"text":"You can customize the appearance of Markdown content by applying different themes using the ","type":"text"},{"type":"codeVoice","code":"markdownTheme(_:)"},{"text":" modifier.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you can apply one of the built-in themes, like ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/Theme\/gitHub"},{"text":", to either a Markdown view or a view hierarchy that","type":"text"},{"text":" ","type":"text"},{"text":"contains Markdown views.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["MarkdownView {","  \"\"\"","  You can quote text with a `>`.","","  > Outside of a dog, a book is man's best friend. Inside of a","  > dog it's too dark to read.","","  – Groucho Marx","  \"\"\"","}",".markdownTheme(.gitHub)"]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"GitHubBlockquote"}]},{"type":"paragraph","inlineContent":[{"text":"To override a specific text style from the current theme, use the ","type":"text"},{"type":"codeVoice","code":"markdownTextStyle(_:textStyle:)"},{"text":" ","type":"text"},{"text":"modifier.  The following example shows how to override the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/Theme\/code"},{"text":" text style.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["MarkdownView {","  \"\"\"","  Use `git status` to list all new or modified files","  that haven't yet been committed.","  \"\"\"","}",".markdownTextStyle(\\.code) {","  FontFamilyVariant(.monospaced)","  FontSize(.em(0.85))","  ForegroundColor(.purple)","  BackgroundColor(.purple.opacity(0.25))","}"]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"CustomInlineCode"}]},{"type":"paragraph","inlineContent":[{"text":"You can also use the ","type":"text"},{"type":"codeVoice","code":"markdownBlockStyle(_:body:)"},{"text":" modifier to override a specific block style. For example, you can","type":"text"},{"text":" ","type":"text"},{"text":"override only the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/Theme\/blockquote"},{"text":" block style, leaving other block styles untouched.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["MarkdownView {","  \"\"\"","  You can quote text with a `>`.","","  > Outside of a dog, a book is man's best friend. Inside of a","  > dog it's too dark to read.","","  – Groucho Marx","  \"\"\"","}",".markdownBlockStyle(\\.blockquote) { configuration in","  configuration.label","    .padding()","    .markdownTextStyle {","      FontCapsVariant(.lowercaseSmallCaps)","      FontWeight(.semibold)","      BackgroundColor(nil)","    }","    .overlay(alignment: .leading) {","      Rectangle()","        .fill(Color.teal)","        .frame(width: 4)","    }","    .background(Color.teal.opacity(0.5))","}"]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"CustomBlockquote"}]},{"type":"paragraph","inlineContent":[{"text":"Another way to customize the appearance of Markdown content is to create your own theme. See the documentation of the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/Theme"},{"text":" type for more information on this subject.","type":"text"}]},{"text":"Customizing link behavior","type":"heading","anchor":"Customizing-link-behavior","level":3},{"type":"paragraph","inlineContent":[{"text":"When a user taps or clicks on a Markdown link, the default behavior is to open Safari. However, you can customize this behavior","type":"text"},{"text":" ","type":"text"},{"text":"by setting the ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" environment value with a custom ","type":"text"},{"type":"codeVoice","code":"OpenURLAction"},{"text":".","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["MarkdownView {","  \"\"\"","  ## Try MarkdownUI","  **MarkdownUI** is a native Markdown renderer for SwiftUI","  compatible with the","  [GitHub Flavored Markdown Spec](https:\/\/github.github.com\/gfm\/).","  \"\"\"","}",".environment(","  \\.openURL,","  OpenURLAction { url in","    print(\"Open \\(url)\")","    return .handled","  }",")"]}]}],"variants":[{"paths":["\/documentation\/markdownui\/markdownview"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownView","interfaceLanguage":"swift"},"references":{"BlockquoteContent":{"variants":[{"traits":["2x","light"],"url":"\/images\/MarkdownUI\/BlockquoteContent@2x.png"},{"traits":["2x","dark"],"url":"\/images\/MarkdownUI\/BlockquoteContent~dark@2x.png"}],"type":"image","alt":null,"identifier":"BlockquoteContent"},"CustomInlineCode":{"variants":[{"traits":["2x","light"],"url":"\/images\/MarkdownUI\/CustomInlineCode@2x.png"},{"traits":["2x","dark"],"url":"\/images\/MarkdownUI\/CustomInlineCode~dark@2x.png"}],"type":"image","alt":null,"identifier":"CustomInlineCode"},"d