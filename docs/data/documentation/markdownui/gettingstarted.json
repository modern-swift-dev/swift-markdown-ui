{"sections":[],"abstract":[{"text":"Learn how to display and style Markdown text in SwiftUI.","type":"text"}],"metadata":{"roleHeading":"Article","title":"Getting started","modules":[{"name":"MarkdownUI"}],"role":"article"},"hierarchy":{"paths":[["doc:\/\/MarkdownUI\/documentation\/MarkdownUI"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Creating a Markdown view","type":"heading","anchor":"Creating-a-Markdown-view","level":2},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"Markdown"},{"text":" view displays rich structured text using the Markdown syntax. It can display images,","type":"text"},{"text":" ","type":"text"},{"text":"headings, lists (including task lists), blockquotes, code blocks, tables, and thematic breaks,","type":"text"},{"text":" ","type":"text"},{"text":"besides styled text and links.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The simplest way of creating a ","type":"text"},{"type":"codeVoice","code":"Markdown"},{"text":" view is to pass a Markdown string to the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownView\/init(_:baseURL:imageBaseURL:)-65h4g"},{"text":" initializer.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let markdownString = \"\"\"","  ## Try MarkdownUI","","  **MarkdownUI** is a native Markdown renderer for SwiftUI","  compatible with the","  [GitHub Flavored Markdown Spec](https:\/\/github.github.com\/gfm\/).","  \"\"\"","","var body: some View {","  MarkdownView(markdownString)","}"]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"MarkdownString"}]},{"type":"paragraph","inlineContent":[{"text":"A more convenient way to create a ","type":"text"},{"type":"codeVoice","code":"Markdown"},{"text":" view is by using the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownView\/init(baseURL:imageBaseURL:content:)"},{"text":" initializer, which takes a Markdown content","type":"text"},{"text":" ","type":"text"},{"text":"builder in which you can compose the view content, either by providing Markdown strings or by","type":"text"},{"text":" ","type":"text"},{"text":"using an expressive domain-specific language.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var body: some View {","  MarkdownView {","    \"\"\"","    ## Using a Markdown Content Builder","    Use Markdown strings or an expressive domain-specific language","    to build the content.","    \"\"\"","    Heading(.level2) {","      \"Try MarkdownUI\"","    }","    Paragraph {","      Strong(\"MarkdownUI\")","      \" is a native Markdown renderer for SwiftUI\"","      \" compatible with the \"","      InlineLink(","        \"GitHub Flavored Markdown Spec\",","        destination: URL(string: \"https:\/\/github.github.com\/gfm\/\")!","      )","      \".\"","    }","  }","}"]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"MarkdownContentBuilder"}]},{"type":"paragraph","inlineContent":[{"text":"You can also create a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownContent"},{"text":" value in your model layer and later create a ","type":"text"},{"type":"codeVoice","code":"Markdown"},{"text":" ","type":"text"},{"text":"view by passing the content value to the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownView\/init(_:baseURL:imageBaseURL:)-6acz4"},{"text":" ","type":"text"},{"text":"initializer. The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownContent"},{"text":" value pre-parses the Markdown string preventing the view from","type":"text"},{"text":" ","type":"text"},{"text":"doing this step.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Somewhere in the model layer","let content = MarkdownContent(\"You can try **CommonMark** [here](https:\/\/spec.commonmark.org\/dingus\/).\")","","\/\/ Later in the view layer","var body: some View {","  MarkdownView(self.model.content)","}"]},{"text":"Styling Markdown","type":"heading","anchor":"Styling-Markdown","level":2},{"type":"paragraph","inlineContent":[{"text":"Markdown views use a basic default theme to display the contents. For more information, read about","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/Theme\/basic"},{"text":" theme.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["MarkdownView {","  \"\"\"","  You can quote text with a `>`.","","  > Outside of a dog, a book is man's best friend. Inside of a","  > dog it's too dark to read.","","  – Groucho Marx","  \"\"\"","}"]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"BlockquoteContent"}]},{"type":"paragraph","inlineContent":[{"text":"You can customize the appearance of Markdown content by applying different themes using the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"markdownTheme(_:)"},{"text":" modifier. For example, you can apply one of the built-in themes, like","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/Theme\/gitHub"},{"text":", to either a Markdown view or a view hierarchy that contains Markdown views.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["MarkdownView {","  \"\"\"","  You can quote text with a `>`.","","  > Outside of a dog, a book is man's best friend. Inside of a","  > dog it's too dark to read.","","  – Groucho Marx","  \"\"\"","}",".markdownTheme(.gitHub)"]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"GitHubBlockquote"}]},{"type":"paragraph","inlineContent":[{"text":"To override a specific text style from the current theme, use the ","type":"text"},{"type":"codeVoice","code":"markdownTextStyle(_:textStyle:)"},{"text":" ","type":"text"},{"text":"modifier. The following example shows how to override the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/Theme\/code"},{"text":" text style.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["MarkdownView {","  \"\"\"","  Use `git status` to list all new or modified files","  that haven't yet been committed.","  \"\"\"","}",".markdownTextStyle(\\.code) {","  FontFamilyVariant(.monospaced)","  FontSize(.em(0.85))","  ForegroundColor(.purple)","  BackgroundColor(.purple.opacity(0.25))","}"]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"CustomInlineCode"}]},{"type":"paragraph","inlineContent":[{"text":"You can also use the ","type":"text"},{"type":"codeVoice","code":"markdownBlockStyle(_:body:)"},{"text":" modifier to override a specific block style. For","type":"text"},{"text":" ","type":"text"},{"text":"example, you can override only the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/Theme\/blockquote"},{"text":" block style, leaving other block styles","type":"text"},{"text":" ","type":"text"},{"text":"untouched.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["MarkdownView {","  \"\"\"","  You can quote text with a `>`.","","  > Outside of a dog, a book is man's best friend. Inside of a","  > dog it's too dark to read.","","  – Groucho Marx","  \"\"\"","}",".markdownBlockStyle(\\.blockquote) { configuration in","  configuration.label","    .padding()","    .markdownTextStyle {","      FontCapsVariant(.lowercaseSmallCaps)","      FontWeight(.semibold)","      BackgroundColor(nil)","    }","    .overlay(alignment: .leading) {","      Rectangle()","        .fill(Color.teal)","        .frame(width: 4)","    }","    .background(Color.teal.opacity(0.5))","}"]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"CustomBlockquote"}]},{"type":"paragraph","inlineContent":[{"text":"Another way to customize the appearance of Markdown content is to create your own theme. To create","type":"text"},{"text":" ","type":"text"},{"text":"a theme, start by instantiating an empty ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/Theme"},{"text":" and chain together the different text and block","type":"text"},{"text":" ","type":"text"},{"text":"styles in a single expression.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["extension Theme {","  static let fancy = Theme()","    .code {","      FontFamilyVariant(.monospaced)","      FontSize(.em(0.85))","    }","    .link {","      ForegroundColor(.purple)","    }","    \/\/ More text styles...","    .paragraph { configuration in","      configuration.label","        .relativeLineSpacing(.em(0.25))","        .markdownMargin(top: 0, bottom: 16)","    }","    .listItem { configuration in","      configuration.label","        .markdownMargin(top: .em(0.25))","    }","    \/\/ More block styles...","}"]},{"text":"Limiting decoded image size","type":"heading","anchor":"Limiting-decoded-image-size","level":3},{"type":"paragraph","inlineContent":[{"text":"The default block and inline image providers share downloads and decoded images for","type":"text"},{"text":" ","type":"text"},{"text":"matching URLs and resolutions. Both preserve original resolution by default. For","type":"text"},{"text":" ","type":"text"},{"text":"large source images, configure a maximum decoded pixel dimension:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["MarkdownView(markdownString)","  .markdownImageProvider(DefaultImageProvider(resolution: .maximumPixelDimension(1200)))","  .markdownInlineImageProvider(DefaultInlineImageProvider(resolution: .maximumPixelDimension(1200)))"]},{"type":"paragraph","inlineContent":[{"text":"The limit applies to the longest decoded dimension and also changes the image’s","type":"text"},{"text":" ","type":"text"},{"text":"intrinsic layout size. Choose it with the desired display size and screen scale in","type":"text"},{"text":" ","type":"text"},{"text":"mind. The decoded-image cache budget does not include images retained by visible","type":"text"},{"text":" ","type":"text"},{"text":"views, downloads in progress, or active decoding allocations.","type":"text"}]},{"text":"Rendering large containers lazily","type":"heading","anchor":"Rendering-large-containers-lazily","level":3},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":".lazyContainers"},{"text":" inside a scroll view to defer offscreen list items and nested","type":"text"},{"text":" ","type":"text"},{"text":"blocks. Tables can also defer rows when their column widths are explicit:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["ScrollView {","  MarkdownView(markdownString)","    .markdownBlockRenderingMode(.lazyContainers)","    .markdownTableColumnWidths([160, 240])","}"]},{"type":"paragraph","inlineContent":[{"text":"Column widths include the theme’s cell padding. Tables with a different column","type":"text"},{"text":" ","type":"text"},{"text":"count, or without valid explicit widths, retain their content-sized eager layout.","type":"text"},{"text":" ","type":"text"},{"text":"Matching explicit widths also apply in eager mode. Lazy tables require standard","type":"text"},{"text":" ","type":"text"},{"text":"solid borders with positive, whole-point widths. Dashed\/custom strokes and","type":"text"},{"text":" ","type":"text"},{"text":"fractional border widths retain eager rendering to preserve their appearance.","type":"text"},{"text":" ","type":"text"},{"text":"Lazy row heights and numbered","type":"text"},{"text":" ","type":"text"},{"text":"marker widths are estimated until measured, so scrolling can adjust layout.","type":"text"},{"text":" ","type":"text"},{"text":"The existing ","type":"text"},{"type":"codeVoice","code":".lazy"},{"text":" mode continues to defer only top-level blocks.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/markdownui\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","identifier":{"url":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/GettingStarted","interfaceLanguage":"swift"},"references":{"BlockquoteContent":{"variants":[{"traits":["2x","light"],"url":"\/images\/MarkdownUI\/BlockquoteContent@2x.png"},{"traits":["2x","dark"],"url":"\/images\/MarkdownUI\/BlockquoteContent~dark@2x.png"}],"type":"image","alt":null,"identifier":"BlockquoteContent"},"CustomInlineCode":{"variants":[{"traits":["2x","light"],"url":"\/images\/MarkdownUI\/CustomInlineCode@2x.png"},{"traits":["2x","dark"],"url":"\/images\/MarkdownUI\/CustomInlineCode~dark@2x.png"}],"type":"image","alt":null,"identifier":"CustomInlineCode"},"doc://MarkdownUI/documentation/MarkdownUI/Theme/gitHub":{"role":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"gitHub","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Theme","kind":"typeIdentifier","preciseIdentifier":"s:10MarkdownUI5ThemeV"}],"abstract":[{"text":"A theme that mimics the GitHub style.","type":"text"}],"title":"gitHub","kind":"symbol","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/Theme\/gitHub","url":"\/documentation\/markdownui\/theme\/github"},"doc://MarkdownUI/documentation/MarkdownUI/Theme/basic":{"role":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":