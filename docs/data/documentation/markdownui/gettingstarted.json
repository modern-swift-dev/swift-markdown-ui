":"keyword"},{"text":" ","kind":"text"},{"text":"MarkdownContent","kind":"identifier"}],"abstract":[{"text":"A Markdown content value.","type":"text"}],"navigatorTitle":[{"text":"MarkdownContent","kind":"identifier"}],"title":"MarkdownContent","kind":"symbol","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownContent","url":"\/documentation\/markdownui\/markdowncontent"},"GitHubBlockquote":{"variants":[{"traits":["2x","light"],"url":"\/images\/MarkdownUI\/GitHubBlockquote@2x.png"},{"traits":["2x","dark"],"url":"\/images\/MarkdownUI\/GitHubBlockquote~dark@2x.png"}],"type":"image","alt":null,"identifier":"GitHubBlockquote"},"doc://MarkdownUI/documentation/MarkdownUI/Theme/blockquote":{"role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockquote","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BlockStyle","kind":"typeIdentifier","preciseIdentifier":"s:10MarkdownUI10BlockStyleV"},{"text":"<","kind":"text"},{"text":"BlockConfiguration","kind":"typeIdentifier","preciseIdentifier":"s:10MarkdownUI18BlockConfigurationV"},{"text":">","kind":"text"}],"abstract":[{"text":"The blockquote style.","type":"text"}],"title":"blockquote","kind":"symbol","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/Theme\/blockquote","url":"\/documentation\/markdownui\/theme\/blockquote"},"doc://MarkdownUI/documentation/MarkdownUI":{"role":"collection","type":"topic","abstract":[{"text":"Display and customize Markdown text in SwiftUI.","type":"text"}],"title":"MarkdownUI","kind":"symbol","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI","url":"\/documentation\/markdownui"},"doc://MarkdownUI/documentation/MarkdownUI/MarkdownView/init(_:baseURL:imageBaseURL:)-65h4g":{"role":"symbol","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"baseURL","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":"?, ","kind":"text"},{"text":"imageBaseURL","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":"?)","kind":"text"}],"abstract":[{"text":"Creates a Markdown view from a Markdown-formatted string.","type":"text"}],"title":"init(_:baseURL:imageBaseURL:)","kind":"symbol","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/MarkdownView\/init(_:baseURL:imageBaseURL:)-65h4g","url":"\/documentation\/markdownui\/markdownview\/init(_:baseurl:imagebaseurl:)-65h4g"},"doc://MarkdownUI/documentation/MarkdownUI/Theme":{"role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Theme","kind":"identifier"}],"abstract":[{"text":"A type that applies a custom appearance to blocks and text inlines in a Markdown view.","type":"text"}],"navigatorTitle":[{"text":"Theme","kind":"identifier"}],"title":"Theme","kind":"symbol","identifier":"doc:\/\/MarkdownUI\/documentation\/MarkdownUI\/Theme","url":"\/documentation\/markdownui\/theme"}}}