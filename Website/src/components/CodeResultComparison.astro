---
import CodeBlock from "./CodeBlock.astro";
interface Props { code: string; }
const { code } = Astro.props;
---
<section class="comparison" aria-labelledby="comparison-heading">
  <div><p class="eyebrow">SwiftUI</p><h2 id="comparison-heading">Markdown in the view hierarchy</h2><CodeBlock code={code} /></div>
  <div class="result" aria-label="Rendered Markdown example"><p class="eyebrow">Rendered result</p><div class="result-paper"><h3>Ship notes</h3><p>MarkdownUI renders rich text with native SwiftUI views.</p><ul><li>Headings and links</li><li>Task lists and tables</li><li><code>Inline code</code> and fenced blocks</li></ul><blockquote>Apply a theme, then override only the styles you need.</blockquote></div></div>
</section>
<style>
  .comparison { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: 1rem; align-items: stretch; } .comparison > * { min-width: 0; } h2 { font-size: clamp(1.5rem, 3vw, 2.1rem); line-height: 1.15; margin: 0 0 1rem; } .result { border: 1px solid #c7d2fe; border-radius: 1rem; background: linear-gradient(135deg, var(--color-accent-pale), var(--color-violet-pale)); padding: 1rem; } .result-paper { border: 1px solid #d8dcff; border-radius: .7rem; background: white; padding: 1.25rem; } h3 { margin: 0; font-size: 1.45rem; } .result-paper p { color: var(--color-muted); } ul { padding-left: 1.2rem; } li + li { margin-top: .35rem; } code { border-radius: .3rem; background: var(--color-accent-pale); padding: .1rem .25rem; } blockquote { border-left: 3px solid var(--color-accent); color: var(--color-muted); margin: 1rem 0 0; padding-left: .75rem; } @media (max-width: 48rem) { .comparison { grid-template-columns: minmax(0, 1fr); } }
</style>
