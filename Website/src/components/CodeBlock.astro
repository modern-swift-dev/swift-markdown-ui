---
interface Props { code: string; language?: string; }
const { code, language = "swift" } = Astro.props;
---
<div class="code-block"><div class="code-label">{language}</div><pre><code>{code}</code></pre></div>
<style>
  .code-block { overflow: hidden; border: 1px solid #312e81; border-radius: 1rem; background: linear-gradient(145deg, #1e1b4b, #172554); color: #eef2ff; }
  .code-label { border-bottom: 1px solid #4c4aa1; color: #c7d2fe; font: 700 .73rem var(--font-mono); letter-spacing: .07em; padding: .55rem .85rem; text-transform: uppercase; }
  pre { overflow-x: auto; margin: 0; padding: 1rem; font-size: .86rem; line-height: 1.65; } code { white-space: pre; }
</style>
