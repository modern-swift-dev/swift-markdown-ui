---
import { withBase } from "../lib/links";
---
<footer>
  <div class="container footer-wrap">
    <p>MarkdownUI is an open-source Swift package.</p>
    <nav aria-label="Footer navigation"><a href={withBase("documentation/")}>Documentation</a><a href={withBase("examples/")}>Examples</a><a href="https://github.com/modern-swift-dev/swift-markdown-ui">GitHub</a></nav>
  </div>
</footer>
<style>
  footer { border-top: 1px solid var(--color-line); margin-top: 5rem; padding-block: 2rem; color: var(--color-muted); font-size: .9rem; }
  .footer-wrap { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  p { margin: 0; } nav { display: flex; flex-wrap: wrap; gap: 1rem; } nav a { color: inherit; }
  @media (max-width: 34rem) { .footer-wrap { align-items: flex-start; flex-direction: column; } }
</style>
