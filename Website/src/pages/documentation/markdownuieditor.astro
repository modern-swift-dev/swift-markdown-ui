---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
const example = `import MarkdownUIEditor\nimport SwiftUI\n\nstruct NotesEditor: View {\n  @State private var markdown = "# Notes"\n\n  var body: some View {\n    MarkdownEditor(markdown: $markdown)\n      .markdownEditorTheme(.gitHub)\n  }\n}`;
---
<BaseLayout title="MarkdownUIEditor documentation" description="Native Markdown editing for SwiftUI, UIKit, and AppKit.">
  <article class="container page">
    <p class="eyebrow">MarkdownUIEditor</p>
    <h1>Edit Markdown in your app.</h1>
    <p>Link the <code>MarkdownUIEditor</code> package product to your app target, then bind Markdown source or a typed <code>MarkdownDocument</code> to the editor. Native editing supports iOS 17+, macOS 15+, and Mac Catalyst 17+.</p>
    <CodeBlock code={example} />
    <p>The binding receives normalized Markdown after edits. The editor includes formatting controls; configure an image provider with <code>markdownEditorImageProvider(_:)</code> to load images.</p>
    <p>The complete site build places the editor's generated DocC guides and API reference at this route.</p>
  </article>
</BaseLayout>
<style>.page { max-width: 48rem; padding-top: 4.5rem; } h1 { font-size: clamp(2.4rem, 6vw, 4rem); letter-spacing: -.06em; line-height: 1; margin: 0; } p:not(.eyebrow) { color: var(--color-muted); font-size: 1.1rem; margin: 1.25rem 0 1.6rem; }</style>
