---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocumentationCard from "../../components/DocumentationCard.astro";
import { withBase } from "../../lib/links";
---
<BaseLayout title="Documentation | MarkdownUI" description="MarkdownUI documentation for SwiftUI projects.">
  <section class="container intro"><p class="eyebrow">Documentation</p><h1>Build Markdown views with SwiftUI.</h1><p>MarkdownUI supports headings, lists, task lists, blockquotes, code blocks, tables, thematic breaks, images, links, and styled text from GitHub Flavored Markdown.</p></section>
  <section class="container grid"><DocumentationCard href={withBase("documentation/getting-started/")} title="Getting started" description="Create a MarkdownView and apply a theme." /><DocumentationCard href={withBase("documentation/markdownui/")} title="MarkdownUI API" description="Open the hosted DocC reference for the package." /></section>
</BaseLayout>
<style>.intro { max-width: 48rem; padding-top: 4.5rem; } h1 { font-size: clamp(2.4rem, 6vw, 4rem); letter-spacing: -.06em; line-height: 1; margin: 0; } .intro > p:last-child { color: var(--color-muted); font-size: 1.1rem; margin-top: 1.25rem; } .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 2.5rem; } @media (max-width: 40rem) { .grid { grid-template-columns: 1fr; } }</style>
