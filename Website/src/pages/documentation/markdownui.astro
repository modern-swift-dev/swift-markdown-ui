---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="MarkdownUI API documentation" description="MarkdownUI DocC API reference.">
  <section class="container page"><p class="eyebrow">API reference</p><h1>MarkdownUI DocC documentation</h1><p>The complete documentation build places generated DocC output at this route. This static site keeps the route available and links to the published reference until that output is assembled.</p><a class="button" href="https://swiftpackageindex.com/modern-swift-dev/swift-markdown-ui/main/documentation/markdownui">Open published DocC documentation <span aria-hidden="true">↗</span></a></section>
</BaseLayout>
<style>.page { max-width: 48rem; padding-top: 4.5rem; } h1 { font-size: clamp(2.4rem, 6vw, 4rem); letter-spacing: -.06em; line-height: 1; margin: 0; } p:not(.eyebrow) { color: var(--color-muted); font-size: 1.1rem; margin: 1.25rem 0 1.6rem; }</style>
