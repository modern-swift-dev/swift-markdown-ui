  {"name": "Leading image", "markdown": "## ![logo](x.png) Title", "expected": ["-title"]},
  {"name": "Trailing image", "markdown": "## Title ![logo](x.png)", "expected": ["title-"]},
  {"name": "Middle image", "markdown": "## Mid ![logo](x.png) dle", "expected": ["mid--dle"]},
  {"name": "Code, bold HTML and link", "markdown": "## `code` <b>bold</b> [link](u)", "expected": ["code-bold-link"]},
  {"name": "HTML attributes", "markdown": "## Hello <span title=\"x\">world</span>", "expected": ["hello-world"]},
  {"name": "Line break HTML", "markdown": "## Pre<br>Post", "expected": ["prepost"]},
  {"name": "Raw image HTML", "markdown": "## <img src=\"x.png\" alt=\"raw\"> Raw img", "expected": ["-raw-img"]},
  {
